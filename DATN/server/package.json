{
  "name": "unishare-server",
  "version": "1.0.0",
  "description": "UniShare REST API – Express + Microsoft SQL Server",
  "main": "server.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:test": "node scripts/testConnection.js",
    "create-admin": "node scripts/createAdmin.js",
    "hash": "node scripts/hashPassword.js",
    "smoke": "node scripts/smokeTest.js"
  },
  "nodemonConfig": {
    "ignore": [
      "uploads/*"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "mssql": "^12.7.11",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "optionalDependencies": {
    "msnodesqlv8": "^5.6.0"
  }
}
