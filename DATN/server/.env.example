# =====================================================================
# UniShare API – biến môi trường mẫu
# Sao chép thành file .env:   copy .env.example .env
# KHÔNG commit file .env lên Git.
# =====================================================================

NODE_ENV=development
PORT=5000
# Có thể khai báo nhiều origin, phân tách bằng dấu phẩy
CLIENT_URL=http://localhost:3000

# ---------------------------------------------------------------------
# DATABASE
# DB_DRIVER=tedious      -> SQL Server / SQL Express qua TCP, đăng nhập bằng SQL login (sa,...)
# DB_DRIVER=msnodesqlv8  -> LocalDB hoặc Windows Authentication (cần ODBC Driver 17/18)
# ---------------------------------------------------------------------
DB_DRIVER=tedious
DB_SERVER=localhost
DB_PORT=1433
# Tên instance, ví dụ SQLEXPRESS. Nếu dùng instance thì có thể để trống DB_PORT (cần SQL Browser).
DB_INSTANCE=
DB_NAME=UniShareDB
DB_USER=sa
DB_PASSWORD=your_sql_password_here
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# --- Chỉ dùng khi DB_DRIVER=msnodesqlv8 ---
# Ví dụ LocalDB:      DB_SERVER=(localdb)\MSSQLLocalDB
# Ví dụ SQL Express:  DB_SERVER=.\SQLEXPRESS
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=true

# ---------------------------------------------------------------------
# AUTH (JWT lưu trong cookie HttpOnly)
# Tạo secret ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_DAYS=7
COOKIE_NAME=unishare_token

# ---------------------------------------------------------------------
# NGHIỆP VỤ
# ---------------------------------------------------------------------
# false = tin đăng mới phải chờ Admin duyệt
PRODUCT_AUTO_APPROVE=false
# true = email đăng ký phải thuộc tên miền email của trường đã chọn
REQUIRE_UNIVERSITY_EMAIL=false
MAX_UPLOAD_SIZE_MB=5
MAX_PRODUCT_IMAGES=6

# ---------------------------------------------------------------------
# QUÊN MẬT KHẨU
# Nếu chưa cấu hình SMTP: link đặt lại mật khẩu được in ra console server.
# EXPOSE_RESET_LINK=true (chỉ khi NODE_ENV=development) trả link trong API để demo.
# ---------------------------------------------------------------------
RESET_TOKEN_EXPIRES_MINUTES=30
EXPOSE_RESET_LINK=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=UniShare <no-reply@unishare.vn>
